{
  "expo": {
    "name": "Rinzo Rider",
    "slug": "rinzo-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rinzorider",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0F14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rinzo.rider"
    },
    "android": {
      "package": "com.rinzo.rider",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0D0F14",
        "foregroundImage": "./assets/images/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rinzo.app"
        }
      ],
      "expo-font",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rinzo uses your location to assign nearby pickups and calculate your delivery earnings."
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rinzo needs photo access so you can attach your documents and a proof-of-delivery photo.",
          "cameraPermission": "Rinzo uses the camera to take a proof-of-delivery photo at handover."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://rinzo.app"
      },
      "eas": {
        "projectId": "15084131-29b8-417d-9843-02ecb4b886f9"
      }
    },
    "owner": "rinzoadmin"
  }
}
